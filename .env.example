# ============================================================================
# Gastos — Variables de entorno
# Copia este archivo a .env.local y completa los valores.
# ============================================================================

# URL de tu proyecto Supabase (Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública (anon) de Supabase (Project Settings → API → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio (service_role) — SOLO se usa en el servidor.
# Necesaria para invitar usuarios. NUNCA la expongas al cliente.
# (Project Settings → API → service_role)
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de la app (para redirecciones de auth).
# En desarrollo: http://localhost:3000. En producción: https://tu-dominio.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
